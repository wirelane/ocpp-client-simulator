# Copy to .env and adjust. Only WEBSOCKET_URL is required.
# Pattern: <protocol>://<server>/apis/emc/cpms/ocppj/<tenant>/<charging station>
WEBSOCKET_URL=wss://ocpp.mycompany.com/apis/emc/cpms/ocppj/mytenant/DEWLNERTP1
CHARGING_STATION_SERIAL_NUMBER=DEWLNERTP1

# Set to any value to auto-accept remote commands. Remove the line for interactive prompts (false also enables auto-accept).
AUTO_ACCEPT=true

# Optional. Defaults are shown.
#CONNECTOR_COUNT=1
#DEFAULT_CONNECTOR_ID=1
#HEARTBEAT_INTERVAL_SECONDS=300
#PLUG_TYPE=Type2

# Optional. Authorize with an RFID UID 15 seconds after boot and stop after NFC_UID_CHARGING_SECONDS.
#NFC_UID=042F3C7A3F3480
#NFC_UID_CHARGING_SECONDS=15

# Optional. Set to any value to enable. Format is XML or OCMF.
#FREE_CHARGING=1
#SEND_SIGNED_METER_VALUES=1
#SIGNED_METER_VALUE_FORMAT=XML
